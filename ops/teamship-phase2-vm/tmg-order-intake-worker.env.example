# Copy this file to ~/newl-apps/.env.tmg-order-intake-worker on the VM.
# Do not commit the real ingestion token or Teamship credentials.

TMG_WORKER_BASE_URL=https://newl-apps.vercel.app
INGESTION_API_TOKEN=replace-with-production-ingestion-token
TMG_WORKER_ID=newl-tmg-order-intake-vm

# The installer does not enable or start the TMG worker. Change this to true
# only during the separately approved live VM activation.
TMG_ALLOW_LIVE_WRITES=false

# The worker polls continuously and handles one approved job at a time.
TMG_WORKER_RUN_ONCE=false
TMG_WORKER_POLL_INTERVAL_MS=15000

# Use the Chrome install already present on the Teamship VM.
TEAMSHIP_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
TMG_BROWSER_HEADED=true
TMG_BROWSER_SLOW_MO_MS=150

# Set these when headed Chrome uses the VM's VNC display.
# Common values are :0 or :1. The installer fills them from the current shell
# when available.
# DISPLAY=:1
# XAUTHORITY=/home/newln8n/.Xauthority
